# Casezo – omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de waarden in.
# Laat de Shopify-variabelen leeg om de demonstratie met lokale voorbeelddata te draaien.

# Winkeldomein, bijvoorbeeld "casezo.myshopify.com" (zonder https://)
SHOPIFY_STORE_DOMAIN=

# Storefront API-versie (stabiele kwartaalversie, zie shopify.dev/docs/api/usage/versioning)
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Privé Storefront-token (Headless-kanaal in Shopify-admin). Alleen server-side gebruikt,
# nooit met NEXT_PUBLIC_ prefixen.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optioneel alternatief: publieke Storefront-token. Wordt eveneens alleen server-side gebruikt.
# Als beide gezet zijn, heeft de privétoken voorrang.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Land en taal voor prijzen en vertalingen (@inContext)
SHOPIFY_COUNTRY_CODE=NL
SHOPIFY_LANGUAGE_CODE=NL

# Cache-duur van de catalogus in seconden
SHOPIFY_REVALIDATE_SECONDS=300

# Publieke URL van de winkel (voor canonieke links en social previews)
SITE_URL=
